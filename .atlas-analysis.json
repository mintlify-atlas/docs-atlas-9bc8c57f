  "keyFeatures": [
    "defineAgent / defineStep authoring contract with compile-time transition enforcement",
    "pauseUntilSignal — durable step suspension across processes with zero compute cost while idle",
    "Events vs signals — events start runs, signals resume paused ones",
    "Typed capability client (@sapiom/tools) for sandboxes, coding models, repositories, file storage, email, search, memory, databases, and more",
    "CLI for scaffold, validate, deploy, schedule, and operate agents",
    "Local developer MCP server (sapiom-dev) for building agents from within a coding agent like Claude Code",
    "Agent Studio — local web app with embedded coding agent terminal, live canvas, and one-click deploy",
    "ctx.shared typed key/value store for cross-step state (256 KiB quota)",
    "Multi-agent composition via agents.run / agents.launch and event triggers",
    "Human-in-the-loop via pauseUntilSignal with arbitrary signal names and optional timeouts"
  ],
  "publicApiSurface": [
    "defineAgent(options) — @sapiom/agent",
    "defineStep(options) — @sapiom/agent",
    "goto(step, payload) — @sapiom/agent",
    "terminate(payload) — @sapiom/agent",
    "fail(message) — @sapiom/agent",
    "retry(options?) — @sapiom/agent",
    "pauseUntilSignal(handle | options, opts) — @sapiom/agent",
    "createClient({ apiKey }) — @sapiom/tools",
    "sandboxes.create / attach / exec / writeFile / destroy — @sapiom/tools",
    "models.run / models.coding.run / models.coding.launch — @sapiom/tools",
    "repositories.create / get / pushFromSandbox — @sapiom/tools",
    "fileStorage.getDownloadUrl — @sapiom/tools",
    "contentGeneration.images.create — @sapiom/tools",
    "search.webSearch / search.scrape — @sapiom/tools",
    "agents.run / agents.launch — @sapiom/tools",
    "schedules.create / list / cancel — @sapiom/tools",
    "email, domains, database, memory, google, slack, linear, llm, decisions — @sapiom/tools",
    "sapiom agents init / check / deploy — @sapiom/cli",
    "sapiom agents emit / signal — @sapiom/cli",
    "sapiom agents schedule create / list / cancel — @sapiom/cli",
    "sapiom_dev_agents_scaffold / check / run_local / deploy / run / inspect — @sapiom/mcp",
    "sapiom_dev_agents_signal / emit_event / schedule — @sapiom/mcp",
    "sapiom_dev_sandbox_configure / preview / app_publish — @sapiom/mcp"
  ]
}
